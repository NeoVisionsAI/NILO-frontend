# Puerto de la API (mismo host que el frontend, distinto puerto).
# La URL se resuelve en runtime: http://<hostname>:8001/api/v1
VITE_API_PORT=8001

# Solo fallback en build/SSR; en el navegador se ignora y se usa window.location.hostname.
# VITE_API_BASE_URL=http://localhost:8001/api/v1

# Nombre visible de la aplicación.
VITE_APP_NAME=NILO

# Puerto en el que se publica el contenedor del frontend (solo Docker).
FRONTEND_PORT=8080
