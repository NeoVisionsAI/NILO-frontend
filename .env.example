# Desarrollo HTTPS (mkcert). Frontend: https://192.168.1.43:8080
FRONTEND_PORT=8080

# Fallback build/SSR; en el navegador se usa la misma origen (/api/v1 proxied).
VITE_API_BASE_URL=https://192.168.1.43:8443/api/v1

# Host/puerto del backend HTTPS (nginx proxy dentro de Docker).
# Debe coincidir con el SAN del certificado del backend (normalmente la IP LAN).
BACKEND_HOST=192.168.1.43
BACKEND_PORT=8443

VITE_DEV_PORT=5173
VITE_APP_NAME=NILO
 