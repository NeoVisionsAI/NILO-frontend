# HTTP :8080 redirige automáticamente a HTTPS :8444 (evita cuelgue con http://IP:8080).
FRONTEND_HTTP_PORT=8080
FRONTEND_SSL_PORT=8444

# App y cámara: https://192.168.1.43:8444
# http://192.168.1.43:8080 → redirect → https://192.168.1.43:8444

VITE_API_BASE_URL=https://192.168.1.43:8443/api/v1

BACKEND_PROXY_HOST=127.0.0.1
BACKEND_SSL_NAME=192.168.1.43
BACKEND_PORT=8443

VITE_DEV_PORT=5173
VITE_APP_NAME=NILO

# Solo HTTPS en :8080 (sin redirect HTTP en el mismo puerto):
# FRONTEND_HTTP_PORT=8080
# FRONTEND_SSL_PORT=8080
# → usar siempre https://192.168.1.43:8080 (http://…:8080 no funciona)
