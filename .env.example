# Desarrollo HTTPS (mkcert). Frontend: https://192.168.1.43:8080
FRONTEND_PORT=8080

# Fallback build/SSR; en el navegador se usa la misma origen (/api/v1 proxied).
VITE_API_BASE_URL=https://192.168.1.43:8443/api/v1

# Puerto del servidor Vite (`npm run dev` → https://<IP>:5173)
VITE_DEV_PORT=5173

VITE_APP_NAME=NILO

# Upstream del backend (solo referencia; nginx usa host.docker.internal:8443).
BACKEND_UPSTREAM=https://host.docker.internal:8443
