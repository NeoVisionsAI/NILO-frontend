# URL base de la API de NILO (incluye el prefijo de versión).
# En desarrollo local con Docker la API se publica en el puerto 8001.
VITE_API_BASE_URL=http://192.168.1.43:8001/api/v1

# Nombre visible de la aplicación.
VITE_APP_NAME=NILO

# Puerto en el que se publica el contenedor del frontend (solo Docker).
FRONTEND_PORT=8080
