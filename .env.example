# HTTPS en puerto 8080 (network_mode: host → nginx escucha directamente en el host).
FRONTEND_PORT=8080

VITE_API_BASE_URL=https://192.168.1.43:8443/api/v1

# Proxy nginx → backend en el mismo host (127.0.0.1, no IP LAN).
BACKEND_PROXY_HOST=127.0.0.1
BACKEND_SSL_NAME=192.168.1.43
BACKEND_PORT=8443

VITE_DEV_PORT=5173
VITE_APP_NAME=NILO
