# Desarrollo HTTPS. Frontend: https://192.168.1.43:8080
FRONTEND_PORT=8080

VITE_API_BASE_URL=https://192.168.1.43:8443/api/v1

# Proxy nginx (Docker) → backend HTTPS en el host.
# PROXY: ruta desde el contenedor (NO la IP LAN; usar host.docker.internal).
BACKEND_PROXY_HOST=host.docker.internal
# SSL: SAN del certificado del backend (IP o hostname que firmó mkcert).
BACKEND_SSL_NAME=192.168.1.43
BACKEND_PORT=8443

VITE_DEV_PORT=5173
VITE_APP_NAME=NILO
