# URL única del frontend (HTTPS obligatorio):
#   https://192.168.1.43:8080
# NO uses http://192.168.1.43:8080 (ese puerto solo habla TLS; http se queda colgado).
FRONTEND_SSL_PORT=8080

VITE_API_BASE_URL=https://192.168.1.43:8443/api/v1

BACKEND_PROXY_HOST=192.168.1.43
BACKEND_SSL_NAME=192.168.1.43
BACKEND_PORT=8443

# Si el proxy /api/v1 falla (504), descomenta y rebuild (--rebuild):
# VITE_API_DIRECT=true

VITE_DEV_PORT=5173
VITE_APP_NAME=NILO

# Aprovisionamiento NiloCardmed: wifi (prod) | bluetooth (legacy/rescate)
VITE_CARDMED_PROVISIONING_MODE=wifi
# URL API local del Pi en modo AP (solo accesible en Nilocardmed-Config-xxxx)
# VITE_CARDMED_WIFI_API_BASE=http://192.168.4.1:8080
