# Copia a credentials.env y ajusta. No versionar credentials.env.

# Imagen GHCR (opcional; por defecto latest)
# FRONTEND_IMAGE=ghcr.io/neovisionsai/nilo-frontend:latest

# Certificados TLS montados en el contenedor (obligatorio para HTTPS :8080)
CERTS_DIR=./certs

# Puerto HTTPS de la app (solo https://<IP>:FRONTEND_SSL_PORT)
FRONTEND_SSL_PORT=8080

# Proxy nginx /api/v1 → backend (misma máquina o LAN)
BACKEND_PROXY_HOST=192.168.1.43
BACKEND_SSL_NAME=192.168.1.43
BACKEND_PORT=8443

# Nota: VITE_* se inyectan en BUILD de la imagen (GitHub Actions).
# Si cambias la URL pública del API, reconstruye la imagen o usa proxy same-origin (VITE_API_DIRECT=false).
